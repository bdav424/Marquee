<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed row slots rather than a RemoteViewsService collection: far less
     machinery for a board that never shows more than a handful of films, and
     nothing to go wrong in an adapter that cannot be debugged from a widget
     host. Unused rows are set to GONE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_sign"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/masthead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/masthead"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textColor="@color/flap_ink" />

        <TextView
            android:id="@+id/stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:textColor="@color/ink_soft" />
    </LinearLayout>

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/title5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />

            <TextView
                android:id="@+id/time5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/flap_ink" />
        </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingTop="10dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="@color/ink_soft" />
</LinearLayout>
