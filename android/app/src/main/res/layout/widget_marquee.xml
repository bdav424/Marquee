<?xml version="1.0" encoding="utf-8"?>
<!-- The sign is drawn as a bitmap by SignRenderer and shown here.

     It used to be six rows of TextViews, which is all RemoteViews can build
     directly — and a list of strings is not a marquee. RemoteViews can host
     an ImageView, and a Canvas can draw flaps, so the whole board is painted
     off-screen and handed over as one image.

     The lamps chase via the ViewFlipper. RemoteViews cannot run an animation,
     but a ViewFlipper cycles its own children on a timer, so each child is
     one phase of the chase: a transparent overlay carrying only the lamps on
     that channel. The sign underneath draws every lamp unlit, so a launcher
     that refuses to animate still shows a complete ring.

     flipInterval is the chase speed. Shorter looks livelier and costs more
     battery, since the launcher redraws on every tick.

     The last ImageView is a transparent tap target: the sign opens the board,
     the corner one forces a refresh. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <ViewFlipper
        android:id="@+id/lamps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="450">

        <ImageView
            android:id="@+id/lamp0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/lamp1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/lamp2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
    </ViewFlipper>

    <!-- Shown only when the bitmap could not be produced or delivered. A
         widget that fails silently is indistinguishable from one that was
         never placed, and this is the one view that costs nothing to send. -->
    <TextView
        android:id="@+id/fallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:visibility="gone"
        android:padding="14dp"
        android:background="@drawable/widget_sign"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="@color/flap_ink" />

    <ImageView
        android:id="@+id/retry"
        android:layout_width="96dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/refresh" />
</FrameLayout>
