<?xml version="1.0" encoding="utf-8"?>
<!-- The sign is drawn as a bitmap by SignRenderer and shown here.

     It used to be six rows of TextViews, which is all RemoteViews can build
     directly — and a list of strings is not a marquee. RemoteViews can host
     an ImageView, and a Canvas can draw flaps, so the whole board is painted
     off-screen and handed over as one image.

     The two ImageViews on top are transparent tap targets: the sign opens the
     board in a browser, the corner one forces a refresh. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <ImageView
        android:id="@+id/retry"
        android:layout_width="96dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/refresh" />
</FrameLayout>
