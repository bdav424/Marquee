<?xml version="1.0" encoding="utf-8"?>
<!-- The marquee serves over plain HTTP, so cleartext has to be permitted —
     but only for the hosts it is actually served from, never app-wide.

     Loopback covers the usual setup, where Termux on this same phone runs the
     fetcher and the server. winchester.local covers a separate box on the
     LAN. Add your own hostname here if it is named something else; a literal
     IP works, a CIDR range does not — Android matches domains, not subnets. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">winchester.local</domain>
    </domain-config>
</network-security-config>
